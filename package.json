{
  "name": "opengrok",
  "productName": "OpenGrok",
  "version": "0.3.0",
  "description": "Desktop workbench for the Grok Build CLI",
  "author": "mckafei_CN",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "compile": "node esbuild.mjs",
    "dev": "node esbuild.mjs && electron .",
    "start": "electron .",
    "pack": "node esbuild.mjs --minify && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "cn.mckafei.opengrok",
    "productName": "OpenGrok",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["en-US", "zh-CN"],
    "afterPack": "./scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main.js",
      "dist/preload.js",
      "!**/node_modules/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "plugin/dist",
        "to": "plugin/dist",
        "filter": [
          "**/*",
          "!**/*.map",
          "!test/**",
          "!**/*.test.js"
        ]
      },
      {
        "from": "plugin/media",
        "to": "plugin/media",
        "filter": [
          "**/*",
          "!katex/fonts/*.ttf",
          "!katex/fonts/*.woff"
        ]
      },
      {
        "from": "desktop",
        "to": "desktop",
        "filter": [
          "index.html",
          "workbench.css",
          "prompt.html",
          "prompt.js"
        ]
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "icon.ico",
          "icon.png",
          "logo.png",
          "logo.svg",
          "SuperGrok.svg",
          "SuperGrokHeavy.svg"
        ]
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OpenGrok",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    }
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "katex": "^0.18.7"
  },
  "devDependencies": {
    "@shikijs/monaco": "^4.4.3",
    "@types/node": "^22.15.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "monaco-editor": "^0.52.2",
    "shiki": "^4.4.3",
    "typescript": "^5.8.3"
  }
}
